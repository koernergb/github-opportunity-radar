{
  "version": "web_api_routes_v1",
  "base_path": "/api/v1",
  "operation_classes": ["read", "local_mutation", "expensive_run", "forbidden"],
  "routes": [
    {"method": "GET", "path": "/health", "class": "read", "confirmation": "none"},
    {"method": "GET", "path": "/readiness", "class": "read", "confirmation": "none"},
    {"method": "GET", "path": "/dashboard", "class": "read", "confirmation": "none"},
    {"method": "GET", "path": "/opportunities", "class": "read", "confirmation": "none"},
    {"method": "GET", "path": "/opportunities/{issue_id}", "class": "read", "confirmation": "none"},
    {"method": "GET", "path": "/opportunities/{issue_id}/explanation", "class": "read", "confirmation": "none"},
    {"method": "POST", "path": "/opportunities/{issue_id}/feedback", "class": "local_mutation", "confirmation": "direct_user_action"},
    {"method": "GET", "path": "/repositories", "class": "read", "confirmation": "none"},
    {"method": "GET", "path": "/repositories/{repository_id}", "class": "read", "confirmation": "none"},
    {"method": "POST", "path": "/repositories/proposals", "class": "local_mutation", "confirmation": "apply_proposal"},
    {"method": "GET", "path": "/preferences", "class": "read", "confirmation": "none"},
    {"method": "GET", "path": "/preferences/revisions", "class": "read", "confirmation": "none"},
    {"method": "POST", "path": "/preferences/proposals", "class": "local_mutation", "confirmation": "apply_proposal"},
    {"method": "POST", "path": "/preferences/revisions/{revision_id}/activate", "class": "local_mutation", "confirmation": "direct_user_action"},
    {"method": "GET", "path": "/preferences/export", "class": "read", "confirmation": "none"},
    {"method": "POST", "path": "/preferences/import", "class": "local_mutation", "confirmation": "direct_user_action"},
    {"method": "GET", "path": "/runs", "class": "read", "confirmation": "none"},
    {"method": "POST", "path": "/runs", "class": "expensive_run", "confirmation": "scope_and_budget"},
    {"method": "GET", "path": "/runs/{run_id}", "class": "read", "confirmation": "none"},
    {"method": "GET", "path": "/runs/{run_id}/events", "class": "read", "confirmation": "none"},
    {"method": "GET", "path": "/runs/{run_id}/stream", "class": "read", "confirmation": "none"},
    {"method": "POST", "path": "/runs/{run_id}/cancel", "class": "local_mutation", "confirmation": "direct_user_action"},
    {"method": "GET", "path": "/conversations", "class": "read", "confirmation": "none"},
    {"method": "POST", "path": "/conversations", "class": "local_mutation", "confirmation": "direct_user_action"},
    {"method": "GET", "path": "/conversations/{conversation_id}", "class": "read", "confirmation": "none"},
    {"method": "POST", "path": "/conversations/{conversation_id}/messages", "class": "local_mutation", "confirmation": "direct_user_action"},
    {"method": "GET", "path": "/assistant/proposals/{conversation_id}", "class": "read", "confirmation": "none"},
    {"method": "POST", "path": "/assistant/proposals/{proposal_id}/confirm", "class": "local_mutation", "confirmation": "exact_proposal"},
    {"method": "POST", "path": "/assistant/proposals/{proposal_id}/reject", "class": "local_mutation", "confirmation": "exact_proposal"},
    {"method": "POST", "path": "/assistant/proposals/{proposal_id}/undo", "class": "local_mutation", "confirmation": "direct_user_action"},
    {"method": "POST", "path": "/assistant/proposals/{proposal_id}/confirm-run", "class": "expensive_run", "confirmation": "scope_and_budget"},
    {"method": "GET", "path": "/schedule", "class": "read", "confirmation": "none"},
    {"method": "PUT", "path": "/schedule", "class": "local_mutation", "confirmation": "direct_user_action"},
    {"method": "POST", "path": "/github/issues/{issue_id}/comment", "class": "forbidden", "confirmation": "unavailable"},
    {"method": "PATCH", "path": "/github/issues/{issue_id}", "class": "forbidden", "confirmation": "unavailable"}
  ]
}
