# Required by doctor --github, repos sync, sync, and run. Use read-only access.
GITHUB_TOKEN=

# Optional provider credentials. Configure the provider selected in profile.yaml.
# When absent, analysis uses the deterministic low-confidence fallback.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
WAFER_API_KEY=

# Defaults to config/profile.yaml when omitted.
RADAR_CONFIG=config/profile.yaml

# SQLAlchemy URL; SQLite is the local-first default.
RADAR_DATABASE_URL=sqlite:///data/radar.sqlite
